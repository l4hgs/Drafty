# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
WHISPER_MODEL=whisper-1
PARSER_MODEL=gpt-4o-mini

# --- Upload limits ---
MAX_AUDIO_BYTES=26214400   # 25 MB (Whisper API limit)
MIN_AUDIO_BYTES=2048       # reject near-empty clips

# --- Server ---
CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- Supabase (used in Step 2: sync endpoint) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
REQUIRE_AUTH=true
