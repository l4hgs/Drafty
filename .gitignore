*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Android / Gradle build artifacts & local config
.gradle/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.kotlin/
*.apk
*.aab
*.ap_
*.dex
captures/

# IDE, OS & logs
.idea/
*.iml
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
