# Environment variables & secrets (NEVER commit)
.env
*.env
.env.*
!.env.example
!backend/.env.example
backend/.env

# Signing keys & credentials
*.jks
*.keystore
keystore.properties
google-services.json

# Python virtual environments & cache
venv/
.venv/
backend/venv/
